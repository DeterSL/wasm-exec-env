# Generated by Cargo
# will have compiled files and executables
/target/

wasm-examples/*/target/

skeletons/*/target/

wasm-examples/*/__pycache__/

skeletons/*/__pycache__/

wasm-examples/matmul/numpy*

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds
*.pdb

# By default, test output
/coverage/

# IntelliJ related
.idea/
*.iml

# VS Code related
.vscode/

# MacOS
.DS_Store

# Byebug
.byebug_history

# Other common
*.log

# Node/Rust interop (wasm-pack, etc)
pkg/
node_modules/

*.wasm
